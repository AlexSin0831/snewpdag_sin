project_root = /data/snoplus3/sin2/snewpdag-clean
initialdir = $(project_root)
executable = $(project_root)/bash/run_poisson_v5_mc_multiple.sh

arguments = $(Process) 20 --det1 SuperK --det2 SuperK --true-lag 0.022 --hist-bin-width 0.002 --coarse-lag-step 0.005 --fine-lag-step 0.0001 --run-name superk-superk-test1000_lag-0p022_bin-width0p002_fine_v5

output = $(project_root)/logs/poisson_v5_batch20.$(Cluster).$(Process).out
error  = $(project_root)/logs/poisson_v5_batch20.$(Cluster).$(Process).err
log    = $(project_root)/logs/poisson_v5_batch20.$(Cluster).log

request_cpus = 1
request_memory = 4GB
request_disk = 2GB

queue 50
