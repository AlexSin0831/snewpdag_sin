executable = /data/snoplus3/sin/snewpdag/run_poisson_v3.sh

output = /data/snoplus3/sin/snewpdag/logs/poisson_v3.$(Cluster).$(Process).out
error  = /data/snoplus3/sin/snewpdag/logs/poisson_v3.$(Cluster).$(Process).err
log    = /data/snoplus3/sin/snewpdag/logs/poisson_v3.$(Cluster).log

request_cpus = 1
request_memory = 2GB
request_disk = 1GB

queue
